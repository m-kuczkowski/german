{
  "name": "wortschatz-a2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:audit": "node scripts/db-audit.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:migrate:test": "node scripts/db-migrate-v2.mjs --test-copy",
    "db:migrate": "node scripts/db-migrate-v2.mjs --apply",
    "db:validate": "node scripts/db-migrate-v2.mjs --validate",
    "db:migrate:grammar": "node scripts/db-migrate-grammar.mjs --apply",
    "db:validate:grammar": "node scripts/db-migrate-grammar.mjs --validate",
    "test:api-integration": "node scripts/api-integration-smoke.mjs",
    "db:push": "node scripts/db-push.mjs",
    "cards:audit": "node scripts/audit-card-quality.mjs",
    "curriculum:build": "python3 scripts/build-learning-priority.py && node scripts/build-goethe-catalog.mjs",
    "audio:source": "node scripts/piper-audio-source.mjs",
    "audio:upload": "node scripts/upload-piper-audio.mjs",
    "test": "vitest run && node scripts/audit-card-quality.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/blob": "^2.6.1",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
